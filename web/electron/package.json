{
  "name": "controlmesa-desktop",
  "productName": "ControlMesa",
  "version": "1.0.0",
  "description": "ControlMesa web em janela desktop, com descoberta automática do servidor",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:web": "cd .. && npm run build && node electron/prepare.js",
    "start": "electron .",
    "dist": "npm run build:web && npm run build:backend && electron-builder --win portable",
    "build:backend": "node prepare-backend.js"
  },
  "build": {
    "appId": "br.com.controlmesa.web",
    "productName": "ControlMesa",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "discovery.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "app-server"
      },
      {
        "from": "../.next/standalone/.next",
        "to": "app-server/.next"
      },
      {
        "from": "backend-bundle",
        "to": "backend"
      },
      {
        "from": "backend-bundle/.env",
        "to": "backend/.env"
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "ControlMesa.exe",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
